# Development Environment Variables for DevContainer
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control - it contains sensitive information

CACHE_BACKEND_URL=redis://redis-cache:6379/0
DEBUG=1
DEBUG_TOOLBAR_ENABLED=0
FRONTEND_URL=http://localhost:5173
SECRET_KEY=some-very-secret-key
SESSION_BACKEND_URL=redis://redis-session:6379/0
SITE_DOMAIN=localhost
SQL_DATABASE=techwiki_dev
SQL_ENGINE=django.db.backends.postgresql
SQL_HOST=db
SQL_PASSWORD=techwiki_dev_password
SQL_PORT=5432
SQL_USER=techwiki


# Microsoft Graph transactional email (use a development app registration/certificate)
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_SENDER_EMAIL=noreply@techwiki.co.uk
# Base64 values are preferred because production injects secrets as environment variables.
MICROSOFT_GRAPH_CERTIFICATE_BASE64=
MICROSOFT_GRAPH_PRIVATE_KEY_BASE64=
# Optional local file fallbacks when the base64 variables are empty:
MICROSOFT_GRAPH_CERTIFICATE_PATH=
MICROSOFT_GRAPH_PRIVATE_KEY_PATH=
MICROSOFT_GRAPH_PRIVATE_KEY_PASSPHRASE=
MICROSOFT_GRAPH_TIMEOUT_SECONDS=15
